{
  "name": "musicall",
  "version": "3.2.0",
  "private": true,
  "description": "Musicall - pemutar musik YouTube Music (streaming audio, lirik sinkron, equalizer, playlist) tanpa API key.",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "rm -rf dist && mkdir -p dist && cp -r public/* dist/",
    "start": "tsx server.ts",
    "smoke": "node test/smoke.cjs",
    "typecheck": "tsc --noEmit",
    "test:player": "node test/player-logic.cjs"
  },
  "keywords": [
    "music",
    "youtube-music",
    "player",
    "lyrics",
    "pwa",
    "vercel"
  ],
  "author": "Tiyanz",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
